# Kopiera den här filen till .env och fyll i riktiga värden.
# .env får ALDRIG checkas in i git — den ligger i .gitignore.

# --- Databas ---------------------------------------------------------------
# Lösenordet används både av Postgres-containern och av appen.
# Skapa ett långt slumpat: openssl rand -base64 32
POSTGRES_PASSWORD=byt-ut-mig
POSTGRES_USER=tikkr
POSTGRES_DB=tikkr

# Inne i Docker heter databasvärden "db" — det är containerns namn.
DATABASE_URL=postgresql://tikkr:byt-ut-mig@db:5432/tikkr?schema=public

# --- Portar på servern -----------------------------------------------------
# Servern kör redan andra saker, så porten går att flytta vid krock.
APP_PORT=3000

# Vem som når appen direkt på porten.
#   0.0.0.0   = alla (bra på testservern, du kan surfa till serverns IP)
#   127.0.0.1 = bara via Nginx Proxy Manager och HTTPS (rätt i produktion)
APP_BIND=0.0.0.0

# --- Backup ----------------------------------------------------------------
# Måste peka på lagring UTANFÖR den här servern. Kräver rclone.
# Exempel: BACKUP_REMOTE=b2:tikkr-backups
# BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14

# --- App -------------------------------------------------------------------
NODE_ENV=production

# --- Fylls i under senare faser --------------------------------------------
# AUTH_SECRET=            # Fas 2, admin-inloggning: openssl rand -base64 32
# AUTH_URL=               # Fas 2, t.ex. https://tikkr.se
# STRIPE_SECRET_KEY=      # Fas 3
# STRIPE_WEBHOOK_SECRET=  # Fas 3
