# Kopiera den här filen till .env och fyll i riktiga värden.
# .env får ALDRIG checkas in i git — den ligger i .gitignore.

# --- Databas ---------------------------------------------------------------
# Lösenordet används både av Postgres-containern och av appen.
# Skapa ett långt slumpat: openssl rand -base64 32
POSTGRES_PASSWORD=byt-ut-mig
POSTGRES_USER=tikkr
POSTGRES_DB=tikkr

# Inne i Docker heter databasvärden "db" — det är containerns namn.
DATABASE_URL=postgresql://tikkr:byt-ut-mig@db:5432/tikkr?schema=public

# --- Portar på servern -----------------------------------------------------
# Servern kör redan andra saker, så porten går att flytta vid krock.
APP_PORT=3000

# Vem som når appen direkt på porten.
#   0.0.0.0   = alla (bra på testservern, du kan surfa till serverns IP)
#   127.0.0.1 = bara via Nginx Proxy Manager och HTTPS (rätt i produktion)
APP_BIND=0.0.0.0

# --- Backup ----------------------------------------------------------------
# Måste peka på lagring UTANFÖR den här servern. Kräver rclone.
# Exempel: BACKUP_REMOTE=b2:tikkr-backups
# BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14

# --- App -------------------------------------------------------------------
NODE_ENV=production

# --- Admin-inloggning ------------------------------------------------------
# Nyckeln som sessionscookies signeras med. Byts den loggas alla ut.
# Skapa en: openssl rand -base64 32
AUTH_SECRET=byt-ut-mig-ocksa

# Låter appen lita på adressen den nås via. Behövs bakom en reverse proxy och
# när panelen nås på IP eller testdomän istället för sitt riktiga namn.
AUTH_TRUST_HOST=true

# --- Schemalagda jobb ------------------------------------------------------
# Skyddar adressen som stänger glömda stämplingar. Utan den vore det en öppen
# väg att stänga alla pågående stämplingar hos alla kunder.
# Skapa en: openssl rand -hex 32
CRON_SECRET=byt-ut-mig-med

# --- E-post ----------------------------------------------------------------
# log   = skriver mejlet i loggen istället för att skicka. Rätt i labbmiljö —
#         inga mejl går ut av misstag till adresser i testdata.
# graph = Microsoft Graph. Kräver de fyra raderna nedan.
MAIL_PROVIDER=log

# Se src/lib/email.ts för hur appregistreringen sätts upp i Entra ID.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=no-reply@dindoman.se

# --- Två adresser: säljsida och system --------------------------------------
# Lämnas de tomma ligger allt på samma adress, vilket är rätt i labbet.
#
# Sätts båda gäller: tikkr.se visar säljsidan, portal.tikkr.se är där man
# loggar in. Systemets sidor på säljadressen skickas vidare till portalen, och
# portalens startsida skickas till inloggningen.
#
# OBS: de här två läses in när appen BYGGS, inte när den startar. Till skillnad
# från övriga rader här räcker det alltså inte med "docker compose up -d" —
# det måste vara "docker compose up -d --build". Orsaken är att omdirigeringen
# körs i en avskalad miljö där värdena bakas in i förväg.
#
# Sätt dem först när båda adresserna pekar på servern OCH har varsin proxy host
# med certifikat i NPM. Annars skickas trafiken till en adress som inte svarar.
#
# MARKETING_HOST tar flera adresser, kommaseparerat. Ange den som ska vara den
# riktiga FÖRST — den används för länkar i sitemap och för sökmotorernas
# uppfattning om vilken adress som gäller.
#
# MARKETING_HOST=www.tikkr.se,tikkr.se
# PORTAL_HOST=portal.tikkr.se

# --- Plattformsadministration ----------------------------------------------
# E-postadresser som får se den interna översikten över alla kundföretag.
# Kommaseparerat. Lämnas den tom finns panelen inte alls.
#
# Att den styrs här och inte i databasen är avsiktligt: ingen kan ge sig själv
# behörigheten inifrån appen, ens med ett kapat ägarkonto.
PLATFORM_ADMIN_EMAILS=

# --- Stripe ----------------------------------------------------------------
# Lämnas de tomma är kortbetalning avstängd. Allt annat fungerar, och
# prenumerationsstatus sätts då för hand i plattformspanelen.
#
# Den hemliga nyckeln ger full åtkomst till Stripe-kontot, inklusive att
# flytta pengar. Den ska aldrig hamna i git, i en chatt eller i ett mejl.
# Börja alltid med testnycklarna (sk_test_...) tills allt fungerar.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_1U3goCRWxc4K2hlrJPDpeJ2a
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Årspriset är valfritt. Saknas det erbjuds bara månadsbetalning.
# STRIPE_PRICE_ID_YEARLY=price_...
