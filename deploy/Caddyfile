# Tikkr i produktion — Caddy framför appen.
#
# Varför Caddy och inte Nginx Proxy Manager som i labbet: hela konfigurationen
# är den här filen, i git. Servern går att återskapa identiskt, och en ändring
# syns i historiken. NPM:s webbgränssnitt ger ingetdera.
#
# Caddy hämtar och förnyar certifikaten själv. DNS för alla adresser nedan
# måste peka på servern INNAN Caddy startas första gången.
#
# Startas med:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Ett värde kommer ur .env:
#   ACME_EMAIL   dit Let's Encrypt skriver om något är fel med ett certifikat
#
# Plattformspanelen skyddas av tvåstegsinloggning i appen, inte av en spärr
# här. En spärr på IP-adress krävde en fast adress hos den som administrerar,
# och stängde ute den som jobbade hemifrån eller från mobilen.

{
	email {$ACME_EMAIL}
}

# Säljsidan. Systemets sidor skickas vidare till portalen av appen själv,
# se src/middleware.ts.
www.tikkr.se, tikkr.se {
	encode zstd gzip
	reverse_proxy tikkr-app:3000
}

portal.tikkr.se {
	encode zstd gzip

	# Caddy skriver själv X-Forwarded-For, -Proto och -Host och litar inte
	# på värden klienten skickat. Det är vad src/lib/client-ip.ts förutsätter.
	reverse_proxy tikkr-app:3000
}
