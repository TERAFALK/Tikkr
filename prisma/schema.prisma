// Tikkr — datamodell
//
// Regel för hela schemat: varje tabell utom `companies` har en `company_id`.
// Det är den kolumnen hela multi-tenant-isoleringen vilar på. Lägg ALDRIG till
// en ny kundnära tabell utan company_id — se src/lib/tenant.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Vad en stämpling avser. Se TimeEntry.kind.
enum TimeEntryKind {
  /// Tid som ska faktureras en kundorder.
  ORDER
  /// Improduktiv tid. Når aldrig ett fakturaunderlag.
  INDIRECT
}

enum OrderStatus {
  OPEN
  CLOSED
}

enum AdminRole {
  OWNER
  ADMIN
}

/// Hur en stämpling kom in i systemet. Viktigt för audit-loggen: en manuellt
/// korrigerad post ska aldrig gå att förväxla med en riktig.
///
/// Beskriver hur posten SKAPADES — utom AUTO_CLOSE, som sätts när systemet
/// själv fått stänga en glömd stämpling vid företagets klockslag. Att en
/// anställd byter jobb räknas INTE som automatisk stängning; då stängde
/// personen posten genom sitt eget tryck.
enum TimeEntrySource {
  KIOSK
  KIOSK_OFFLINE_SYNC
  ADMIN_MANUAL
  AUTO_CLOSE
}

/// Varför en anställd inte var på plats.
///
/// Tikkr räknar TIMMAR, aldrig kronor. Typen finns för att timmarna ska kunna
/// redovisas var för sig i tidrapporten och för att en frånvarodag inte ska
/// straffa flexsaldot — vad frånvaron är värd i lön avgörs i lönesystemet, av
/// kollektivavtalet. Se CLAUDE.md § 3 regel 7.
enum AbsenceType {
  SJUK
  VAB
  SEMESTER
  FORALDRALEDIG
  TJANSTLEDIG
  PERMISSION

  /// Uttagen komptid. Drar även på komptidssaldot, se comp_adjustments.
  KOMP_UTTAG

  OVRIGT
}

/// Ett kundföretag. Detta är den enda tabellen utan company_id — den ÄR tenanten.
model Company {
  id                 String             @id @default(cuid())
  name               String
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")

  /// När provperioden tar slut. Sätts vid registrering.
  trialEndsAt DateTime? @map("trial_ends_at")

  /// När betalningen började utebli. Nollställs när den går igenom.
  /// Behövs för att kunna ge några dagars respit istället för att låsa
  /// panelen i samma sekund som ett kort råkar gå ut.
  pastDueSince DateTime? @map("past_due_since")

  /// Hur många stämplingsskärmar företaget får ha aktiva samtidigt.
  ///
  /// Under provperioden två stycken, vilket räcker för att prova på riktigt.
  /// Vid köp väljer kunden antal, och det antalet blir kvantiteten på
  /// prenumerationen. Vill de ha fler ökar de licenserna, vilket ändrar
  /// fakturan — så att kostnaden aldrig växer utan att någon bestämt det.
  screenLicenses Int @default(2) @map("screen_licenses")

  /// Kopplingen till Stripe. Kunden hos oss och kunden hos Stripe är samma
  /// företag, men har olika id — de här raderna binder ihop dem.
  ///
  /// Betalningsuppgifter lagras aldrig här. Kortnummer rör aldrig vår server;
  /// kunden fyller i dem hos Stripe och vi får bara veta att det gick bra.
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  /// "month" eller "year". Behövs för att räkna om årsbetalningar till en
  /// jämförbar månadsintäkt i plattformsöversikten.
  subscriptionInterval String? @map("subscription_interval")

  /// Klockslag då glömda stämplingar stängs automatiskt, "HH:MM".
  /// Posten stängs men flaggas för granskning — aldrig en tid i tysthet.
  autoCloseAt String @default("18:00") @map("auto_close_at")

  /// Behövs för att veta när "18:00" inträffar. Sommartid hanteras av
  /// tidszonen — hade vi räknat i UTC hade utstämplingen glidit en timme
  /// mellan sommar och vinter.
  timezone String @default("Europe/Stockholm")

  /// Påslag på självkostnaden i kalkylen, i PROCENT. 140 betyder ×1,40.
  ///
  /// Heltalsprocent och inte en faktor med decimaler, eftersom 1,4 inte går
  /// att lagra exakt — och ett påslag som råkar bli 1,3999 ger ören i diff
  /// mot det kunden räknat för hand.
  ///
  /// Standard 100, alltså inget påslag alls. Ett företag som inte fyllt i
  /// något ska få se sin kostnad, inte ett pris systemet hittat på.
  markupPercent Int @default(100) @map("markup_percent")

  /// Kundens logotyper. Två stycken, för att en logotyp sällan fungerar på
  /// båda ställena: märket i ett hörn vill vara fyrkantigt och fylla sin ruta,
  /// medan det på ett dokument vill vara brett med namnet utskrivet.
  ///
  /// Kvadratisk — märket i panelen och på stämplingsskärmen.
  logoSquareData     Bytes?  @map("logo_square_data")
  logoSquareMimeType String? @map("logo_square_mime_type")
  /// Bred — överst på underlag som skickas vidare till kundens kund.
  logoWideData       Bytes?  @map("logo_wide_data")
  logoWideMimeType   String? @map("logo_wide_mime_type")

  /// När någon av dem senast ändrades. Används för att webbläsaren ska sluta
  /// visa den gamla bilden efter en uppladdning.
  logoUpdatedAt DateTime? @map("logo_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees       Employee[]
  orders          Order[]
  orderBudgets    OrderBudget[]
  workMoments     WorkMoment[]
  indirectMoments IndirectMoment[]
  timeEntries     TimeEntry[]
  adminUsers      AdminUser[]
  adminInvites    AdminInvite[]
  kioskDevices    KioskDevice[]
  customers       Customer[]
  supportVisits   SupportVisit[]

  // Löneunderlaget. Se avsnittet längst ner i filen.
  workSchedules   WorkSchedule[]
  scheduleDays    ScheduleDay[]
  scheduleBreaks  ScheduleBreak[]
  breakTypes      BreakType[]
  breakEntries    BreakEntry[]
  absences        Absence[]
  compAdjustments CompAdjustment[]

  @@map("companies")
}

model Employee {
  /// Radens nyckel i databasen. En slumpad sträng som aldrig visas för någon.
  ///
  /// Namnet är AVSIKTLIGT inte unikt: två personer på samma företag kan heta
  /// Anders Andersson, och att tvinga fram ett påhittat särskiljande namn vore
  /// att lösa ett datorproblem med människors namn. Anställningsnumret nedan
  /// finns för att kunna skilja dem åt på ett sätt kunden känner igen.
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  name      String
  active    Boolean @default(true)

  /// Kundens eget nummer på personen. Frivilligt.
  ///
  /// Visas ALDRIG på stämplingsskärmen. Den anställde trycker på sitt namn,
  /// och ett nummer bredvid gör knappen svårare att läsa utan att hjälpa
  /// någon. I panelen och i rapporterna står det däremot med, eftersom det är
  /// där två personer med samma namn behöver hållas isär.
  employeeNumber String? @map("employee_number")

  /// Vad en timme av PERSONENS tid kostar företaget, i ÖREN. Frivillig.
  ///
  /// Läggs TILL arbetsmomentets timkostnad. Svetsar Anna, som kostar 350 kr i
  /// timmen, vid en fräs som kostar 500, är radens självkostnad 850 kr per
  /// timme. Momentet är maskinen och den här raden är människan; en verkstad
  /// betalar för båda samtidigt.
  ///
  /// VISAS ALDRIG PÅ STÄMPLINGSSKÄRMEN. Kiosken visar inga belopp alls, och
  /// det är med flit: vad en person kostar företaget är ingen uppgift att
  /// hänga på en skärm i verkstaden.
  ///
  /// Tomt betyder att kostnaden inte är angiven, vilket är något annat än noll
  /// kronor. Saknas båda satserna redovisar kalkylen raden som saknat underlag
  /// i stället för att tyst visa noll.
  costRateOre Int? @map("cost_rate_ore")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Porträtt som visas på stämplingsskärmen.
  ///
  /// Ligger i databasen och inte som fil på disk, av samma skäl som
  /// företagets logotyp: en säkerhetskopia av databasen ska innehålla allt.
  /// En bild på en person är dessutom en personuppgift, och den ska följa med
  /// när personen anonymiseras — vilket den gör automatiskt när den ligger på
  /// samma rad.
  photoData      Bytes?    @map("photo_data")
  photoMimeType  String?   @map("photo_mime_type")
  photoUpdatedAt DateTime? @map("photo_updated_at")

  /// Schemat personen går på. Tomt betyder företagets standardschema, vilket
  /// är det normala — en verkstad har oftast ett enda schema som alla följer.
  scheduleId String? @map("schedule_id")

  /// Flexsaldot när Tikkr togs i bruk, i minuter. Kan vara negativt.
  ///
  /// Finns för att en kund som byter system har saldon sedan tidigare. Utan
  /// det skulle alla börja om på noll, och personalen skulle förlora timmar de
  /// arbetat in.
  flexOpeningMinutes Int @default(0) @map("flex_opening_minutes")

  /// Komptidssaldot när Tikkr togs i bruk, i minuter.
  compOpeningMinutes Int @default(0) @map("comp_opening_minutes")

  /// Dagen saldona ovan gällde. Tikkr räknar från och med denna dag och
  /// framåt; allt före den ligger i ingående saldo.
  ///
  /// Tomt betyder att personen räknas från sin första stämpling.
  balanceOpeningDate DateTime? @map("balance_opening_date")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  schedule        WorkSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  breakEntries    BreakEntry[]
  absences        Absence[]
  compAdjustments CompAdjustment[]

  // Numret är unikt per företag, inte globalt. Två olika kunder ska kunna ha
  // varsin anställd med nummer 1 utan att krocka. Flera personer utan nummer
  // är tillåtet — Postgres räknar inte tomma värden som dubbletter.
  @@unique([companyId, employeeNumber])
  @@index([companyId, active])
  @@map("employees")
}

/// EN KUND. Skapas en gång, väljs sedan.
///
/// Ersätter fritextfältet `Order.customerName`. Tre saker blev möjliga med
/// bytet: kunden går att fråga om ("vad har vi gjort åt Teltek i år"), namnet
/// stavas likadant överallt, och uppgifterna behöver inte skrivas för hand på
/// varje underlag som bifogas en faktura.
model Customer {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  name      String

  /// Kundens nummer hos ER. Frivilligt, men unikt när det finns — två kunder
  /// med samma nummer går inte att skilja åt i efterhand.
  customerNumber String? @map("customer_number")
  orgNumber      String? @map("org_number")

  contactName String? @map("contact_name")
  email       String?
  phone       String?

  addressLine String? @map("address_line")
  postalCode  String? @map("postal_code")
  city        String?

  /// Påslag för kundens ordrar, i procent. Tomt = företagets standard.
  ///
  /// Ordningen är order → kund → företag, första ifyllda vinner. Se
  /// src/lib/order-price.ts, som äger hela räkningen.
  markupPercent Int? @map("markup_percent")

  /// Stående rabatt i procent, dras av EFTER påslaget.
  ///
  /// Skild från påslaget med flit, fast båda påverkar priset: påslaget är
  /// internt och räknar fram vad jobbet ska ge, rabatten är det kunden ser och
  /// har kommit överens om. Kalkylen skriver ut båda på var sin rad, aldrig
  /// bara resultatet — ett pris som inte går att bryta ned går inte att
  /// försvara för den som ifrågasätter fakturan.
  discountPercent Int? @map("discount_percent")

  /// Fritext för kontoret. Når aldrig ett underlag som går till kunden.
  notes String?

  /// Avaktiverad kund syns inte i väljarna men behåller sina ordrar.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  // Numret är unikt per företag, inte globalt. Två kunder till Tikkr ska kunna
  // ha varsin kund nummer 1. Flera utan nummer är tillåtet — Postgres räknar
  // inte tomma värden som dubbletter.
  @@unique([companyId, customerNumber])
  @@index([companyId, active])
  @@index([companyId, name])
  @@map("customers")
}

model Order {
  id          String      @id @default(cuid())
  companyId   String      @map("company_id")
  orderNumber String      @map("order_number")
  status      OrderStatus @default(OPEN)

  /// Kunden ordern görs åt. Frivillig.
  ///
  /// Var fritext fram till 2026-09-26. Då blev "Volvo", "volvo lastvagnar" och
  /// "VOLVO AB" tre kunder i varje rapport, och ingenting gick att fråga om en
  /// kund — den fanns inte som något systemet kände till.
  ///
  /// Tomt är tillåtet: ett snabbjobb från skärmen skapas ibland av någon som
  /// inte vet vem kunden är, och att tvinga fram ett val då hade gett FEL kund
  /// i stället för ingen kund.
  customerId String? @map("customer_id")

  /// Skapad från stämplingsskärmen av en anställd, inte av admin.
  ///
  /// Finns för att arbetet ibland börjar innan kontoret hunnit lägga upp
  /// ordern. Utan den här utvägen stämplar folk på fel order eller inte alls,
  /// och den timmen går inte att rekonstruera i efterhand.
  ///
  /// Flaggan betyder "någon bör titta på den här": ordernumret kan vara
  /// avskrivet fel och kunden kan saknas. Den nollställs när en administratör
  /// sparat orderns uppgifter — det är kvittot på att någon sett den.
  isQuickJob Boolean @default(false) @map("is_quick_job")

  /// Fast pris mot kund för hela ordern, i ÖREN. Frivilligt.
  ///
  /// Ifyllt betyder fastprisorder: kalkylen visar det här som PRIS och räknar
  /// vinsten mot självkostnaden, i stället för att räkna upp kostnaden med
  /// påslaget. Tomt betyder löpande räkning, och då gäller påslaget.
  ///
  /// Skälet till att båda finns: kunden har bägge sorternas affärer, och en
  /// fastprisorder där systemet räknar fram ett "pris" ur ett påslag visar en
  /// siffra ingen har kommit överens om.
  fixedPriceOre Int? @map("fixed_price_ore")

  /// Påslag för just den här ordern, i procent. Åsidosätter företagets.
  /// Används inte när fixedPriceOre är satt — då finns priset redan.
  ///
  /// Tomt betyder att företagets standard gäller, vilket är det normala.
  /// Finns för den order där kunden förhandlat — annars hade man fått ändra
  /// företagets påslag fram och tillbaka och råkat fakturera fel på allt
  /// annat under tiden.
  markupPercent Int?     @map("markup_percent")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  /// Den beräknade tiden, uppdelad per arbetsmoment. Se OrderBudget.
  budgets OrderBudget[]

  // Restrict och inte Cascade: en kund med ordrar ska inte gå att radera, bara
  // avaktiveras. Samma regel som redan gäller ordrar och arbetsmoment med
  // registrerad tid — underlaget får inte försvinna under händerna på någon.
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Ordernummer är unikt per företag — inte globalt. Två olika kunder ska
  // kunna ha varsin order "1001" utan att krocka.
  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, isQuickJob])
  @@map("orders")
}

model WorkMoment {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  name      String
  active    Boolean @default(true)

  /// Vad en timme av det här momentet kostar företaget, i ÖREN. Frivillig.
  ///
  /// Ören och inte kronor, av samma skäl som tid lagras i minuter: 182,50 kr
  /// går inte att spara exakt som decimaltal, och avrundningen blir synlig så
  /// fort hundra rader summeras.
  ///
  /// Kostnad, inte pris. Vad kunden ska betala räknas fram genom påslaget på
  /// företaget eller ordern — se Company.markupPercent.
  ///
  /// Tomt betyder att kostnaden inte är angiven, vilket är något annat än noll
  /// kronor. Kalkylen räknar då raden som noll OCH säger att underlag saknas,
  /// i stället för att tyst visa en för låg summa.
  costRateOre Int? @map("cost_rate_ore")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  budgets     OrderBudget[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("work_moments")
}

/// BERÄKNAD TID FÖR ETT ARBETSMOMENT PÅ EN ORDER.
///
/// Var en enda siffra på ordern fram till 2026-09-26. Den siffran gick att
/// jämföra med utfallet men inte att förklara: en order som gått över sin
/// beräkning sa ingenting om VAR tiden tog vägen, och nästa kalkyl gissade
/// lika illa som den förra. Nu beräknas tiden där den uppstår — svetsningen
/// för sig, fräsningen för sig.
///
/// Orderns totala beräkning är summan av raderna. Den lagras aldrig som ett
/// eget fält: två ställen som säger samma sak hinner alltid sluta göra det.
///
/// Minuter och inte timmar, av samma skäl som all annan tid i systemet: 7,5
/// timmar går inte att spara exakt som decimaltal, och en avrundning som
/// upprepas hundra gånger blir en timme fel i en rapport.
///
/// Systemet stoppar aldrig stämpling för att tiden överskrids. Ordern får
/// kosta mer än beräknat — det är information till den som fakturerar, inte
/// en spärr mot att arbeta.
model OrderBudget {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  orderId   String @map("order_id")
  momentId  String @map("moment_id")

  /// Beräknad tid för momentet, i minuter. Alltid större än noll — en rad som
  /// inte fyllts i sparas inte, eftersom "noll timmar" och "ingen beräkning"
  /// är två olika svar.
  minutes Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Restrict, som för registrerad tid: ett arbetsmoment som någon räknat med
  // ska inte kunna försvinna under en pågående order. Moment avslutas ändå
  // genom att de avaktiveras, aldrig genom radering.
  moment WorkMoment @relation(fields: [momentId], references: [id], onDelete: Restrict)

  // Ett moment får bara beräknas en gång per order. Två rader för samma
  // moment vore två svar på samma fråga, och summan skulle bero på vilken
  // rad man råkade titta på.
  @@unique([orderId, momentId])
  @@index([companyId, orderId])
  @@map("order_budgets")
}

/// En stämpling. clockOutAt = null betyder "pågår just nu".
/// Improduktiv tid: städning, möten, underhåll.
///
/// Eget register, skilt från WorkMoment med flit. Två skäl. Det ska vara
/// omöjligt att råka välja Städning på en kundorder, och det ska vara lika
/// omöjligt att råka få med den tiden i ett fakturaunderlag. En bock på
/// WorkMoment hade gett båda felen en chans.
///
/// Ingen timkostnad här. Improduktiv tid kalkyleras inte — den redovisas.
model IndirectMoment {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  name      String
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("indirect_moments")
}

model TimeEntry {
  id         String @id @default(cuid())
  companyId  String @map("company_id")
  employeeId String @map("employee_id")

  /// Vad stämplingen avser. ORDER är tid som ska faktureras en kundorder,
  /// INDIRECT är improduktiv tid som aldrig når ett fakturaunderlag.
  ///
  /// Fältet är diskriminatorn: exakt ett av fältparen nedan är ifyllt. ORDER
  /// har order + moment, INDIRECT har indirectMoment. Databasen kan inte
  /// uttrycka det villkoret — prisma db push saknar CHECK — så det vaktas i
  /// src/lib/clock.ts, som är enda vägen in.
  kind TimeEntryKind @default(ORDER)

  /// Ifyllda när kind = ORDER. Restrict: en order eller ett moment går inte
  /// att radera så länge det finns registrerad tid på det.
  orderId  String? @map("order_id")
  momentId String? @map("moment_id")

  /// Ifyllt när kind = INDIRECT. Städning, möte, underhåll — tid som lagts
  /// ner men inte på någon kunds order.
  indirectMomentId String? @map("indirect_moment_id")

  clockInAt  DateTime  @map("clock_in_at")
  clockOutAt DateTime? @map("clock_out_at")

  source TimeEntrySource @default(KIOSK)

  /// SJÄLVKOSTNADEN, SOM DEN VAR NÄR STÄMPLINGEN GJORDES.
  ///
  /// Två fält, inte ett hopslaget. Kalkylen ska kunna skriva "person 350 +
  /// maskin 500 = 850 kr/tim" i stället för bara 850, eftersom ett belopp som
  /// inte går att bryta ned inte går att förklara för den som ifrågasätter
  /// fakturan.
  ///
  /// Kopior, inte uppslagningar. Höjer företaget Svetsning från 180 till 200
  /// kr ska en kalkyl som redan tagits ut och fakturerats se likadan ut om ett
  /// år — annars stämmer underlaget inte längre med fakturan som skickades.
  /// Nya stämplingar får de nya satserna.
  ///
  /// Tomt betyder att satsen inte var angiven, inte att den var noll. Radens
  /// kostnad är summan av de satser som FINNS; saknas båda redovisar kalkylen
  /// raden som saknat underlag i stället för som noll kronor.
  ///
  /// Improduktiv tid har aldrig några satser. Den kalkyleras inte alls.
  momentCostRateOre   Int? @map("moment_cost_rate_ore")
  employeeCostRateOre Int? @map("employee_cost_rate_ore")

  /// Sätts när systemet räknat fram en utstämpling, t.ex. vid det
  /// automatiska klockslaget. Admin får en lista att gå igenom och rätta.
  needsReview Boolean @default(false) @map("needs_review")

  /// Varför posten flaggades, i klartext för admin.
  /// Exempel: "Automatiskt utstämplad 18:00 — ingen utstämpling registrerad".
  reviewNote String? @map("review_note")

  /// Sätts av kioskskärmen vid varje tryck. Ligger nätet nere sparas
  /// stämplingen lokalt och skickas senare — ibland flera gånger, om skärmen
  /// inte hann få kvittensen. Det här id:t gör att en omsändning känns igen
  /// och inte blir en dubblett. Se @@unique längre ner.
  clientPunchId String? @map("client_punch_id")

  /// Skärmens id för det tryck som STÄNGDE posten.
  ///
  /// Eget fält, inte samma som clientPunchId: en post bär redan sin
  /// instämplings id, och ett fält kan inte hålla två.
  ///
  /// Utan det här fungerade dubblettskyddet aldrig för utstämplingar —
  /// clockOut letade efter ett tidigare tryck men skrev aldrig något, så
  /// uppslaget kunde per definition inte träffa. En omsänd utstämpling kunde
  /// därmed stänga ett jobb personen hunnit starta efteråt.
  ///
  /// INTE unikt, till skillnad från clientPunchId: "stämpla ut allt" stänger
  /// flera poster med ETT tryck, och alla får samma id. Indexet räcker för
  /// uppslaget, och ett dubblettskydd som vägrar sin egen avsedda användning
  /// vore sämre än inget.
  clockOutPunchId String? @map("clock_out_punch_id")

  // Audit-logg: vem/var/när, så en felaktig stämpling går att reda ut i efterhand.
  kioskDeviceId String?  @map("kiosk_device_id")
  sourceIp      String?  @map("source_ip")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Restrict: en order eller ett moment går inte att radera så länge det finns
  // registrerad tid på den. Tidsdatan är fakturaunderlag och får inte tappa
  // sin koppling. Admin stänger ordern istället för att radera den.
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  moment         WorkMoment?     @relation(fields: [momentId], references: [id], onDelete: Restrict)
  indirectMoment IndirectMoment? @relation(fields: [indirectMomentId], references: [id], onDelete: Restrict)

  kioskDevice KioskDevice? @relation(fields: [kioskDeviceId], references: [id], onDelete: SetNull)

  // Skyddet mot dubbletter från offline-kön. Unikt per företag, inte globalt.
  @@unique([companyId, clientPunchId])
  // Snabbar upp den vanligaste frågan: "har den här personen en öppen stämpling?"
  @@index([companyId, employeeId, clockOutAt])
  @@index([companyId, clockInAt])
  @@index([companyId, orderId])
  @@index([companyId, indirectMomentId])
  // Bär rapportfrågorna, som nästan alltid vill ha en av sorterna.
  @@index([companyId, kind, clockInAt])
  // Adminlistan över poster som behöver granskas.
  @@index([companyId, needsReview])
  // Bär dubblettkontrollen vid varje utstämpling från offline-kön.
  @@index([companyId, clockOutPunchId])
  @@map("time_entries")
}

model AdminUser {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// När lösenordet senast byttes.
  ///
  /// Sessioner som skapats före den tidpunkten avvisas. Utan det fältet skulle
  /// ett lösenordsbyte inte kasta ut den som redan är inne — och det är just
  /// vad man byter lösenord för när man misstänker att någon annan kommit åt
  /// kontot.
  passwordChangedAt DateTime? @map("password_changed_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  passwordResets PasswordReset[]

  @@index([companyId])
  @@map("admin_users")
}

/// En begärd lösenordsåterställning.
///
/// Byggd som AdminInvite: bara fingeravtrycket av länken sparas, den har en
/// utgångstid och den går att lösa in exakt en gång. Skillnaden är livslängden
/// — en inbjudan får ligga en vecka, en återställning en timme. Den som glömt
/// sitt lösenord sitter framför datorn just nu, och en länk som ligger kvar i
/// en inkorg i en vecka är en väg in för den som kommer åt inkorgen senare.
model PasswordReset {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// Bara fingeravtrycket sparas. Länken finns aldrig i databasen.
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  /// Vem som bad om den, för att kunna reda ut ett ifrågasatt lösenordsbyte.
  requestedFromIp String? @map("requested_from_ip")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_resets")
}

/// Ett konto för den som driver hela Tikkr — inte en kund.
///
/// Skilt från admin_users med flit. En plattformsadministratör tillhör inget
/// företag, och ska inte behöva ett kundkonto för att komma åt sin egen
/// driftpanel.
///
/// Två oberoende villkor måste vara uppfyllda för att komma in:
///   1. Adressen står i PLATFORM_ADMIN_EMAILS på servern (behörighet)
///   2. Det finns en rad här med rätt lösenord (identitet)
///
/// Att de är åtskilda är poängen. Den som kommer åt databasen kan lägga till
/// en rad här men inte ge sig själv behörighet; den som kommer åt .env kan ge
/// behörighet men inte skapa ett lösenord. Båda krävs.
model PlatformUser {
  email        String    @id
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("platform_users")
}

/// Logg över vad plattformsadministratörer gjort.
///
/// Panelen där du ser alla kunder går utanför företagsfiltreringen. Allt som
/// ÄNDRAR något där ska gå att härleda i efterhand — vem, vad, när och varför.
/// Utan det är det din utsaga mot kundens den dag något ifrågasätts.
///
/// Fältet heter targetCompanyId och inte companyId med flit: raden tillhör
/// plattformen, inte kunden, och ska aldrig omfattas av det filtrerande lagret.
/// Intäktsläget en viss dag.
///
/// Skrivs av schemajobbet, en rad per dag. Utan den här tabellen går det bara
/// att se nuläget — och nuläget säger ingenting om riktningen, som är det som
/// betyder något. Historiken kan inte räknas fram i efterhand, eftersom en
/// avslutad prenumeration inte lämnar spår om vad den var värd.
model RevenueSnapshot {
  /// Dagen raden avser, satt till midnatt. Unik, så att jobbet kan köra ofta
  /// utan att skapa dubbletter.
  day DateTime @id

  /// Återkommande månadsintäkt i kronor. Årsbetalningar omräknade.
  mrr Int

  payingCompanies   Int @map("paying_companies")
  trialingCompanies Int @map("trialing_companies")
  licensesSold      Int @map("licenses_sold")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("revenue_snapshots")
}

/// Små driftvärden som inte förtjänar en egen tabell.
///
/// Exempelvis när schemajobbet senast kördes. Ett fält per rad, så att ett
/// nytt värde inte kräver en schemaändring.
/// ETT SUPPORTBESÖK — när någon hos leverantören sett en kunds panel.
///
/// Åtkomsten sker i LÄSLÄGE och kringgår kundens lösenord, vilket är precis
/// därför den måste lämna ett spår. Utan den här tabellen finns ingenting som
/// visar att en utomstående läst kundens anställda, tider och kunduppgifter.
///
/// Står MEDVETET utanför tenant-filtreringen trots company_id: raden gäller
/// leverantörens åtkomst till kunden, inte kundens egen data, och läses bara i
/// plattformspanelen. Därför registreras den inte i TENANT_SCOPED_MODELS —
/// undantaget som testet `alla kundnära modeller är registrerade` måste känna.
model SupportVisit {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  /// Plattformskontots adress. Inte ett kundkonto — inget sådant lånas.
  email String

  startedAt DateTime @default(now()) @map("started_at")

  /// Senaste sidladdningen under besöket. Ger längden utan att kräva att någon
  /// kommer ihåg att trycka "avsluta" — en stängd flik lämnar aldrig ett slut.
  /// Uppdateras högst en gång per minut, annars blir en halvtimme trettio
  /// skrivningar.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startedAt])
  @@index([startedAt])
  @@map("support_visits")
}

model PlatformState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_state")
}

/// Vad ett driftmeddelande gäller. Styr färg och rubrik, inget annat.
enum NoticeKind {
  /// Planerat underhåll, känt i förväg.
  MAINTENANCE
  /// Något är trasigt just nu.
  INCIDENT
  /// Övrig information, exempelvis en ny funktion.
  INFO
}

/// Ett driftmeddelande som visas för alla kunder.
///
/// Gäller hela installationen och inte ett enskilt företag — därför inget
/// company_id, och därför ligger den utanför företagsfiltreringen. Ett
/// meddelande riktat till en enskild kund hör hemma i ett mejl eller i
/// anteckningen om företaget, inte i en banner alla ser.
///
/// Tidsstyrd med flit: ett planerat underhåll läggs in i förväg och dyker upp
/// av sig själv vid rätt tidpunkt. Ett meddelande som kräver att någon minns
/// att slå på det klockan sju på morgonen kommer inte att visas.
model SystemNotice {
  id    String     @id @default(cuid())
  kind  NoticeKind @default(MAINTENANCE)
  title String
  body  String

  /// När meddelandet börjar visas.
  startsAt DateTime @map("starts_at")

  /// När det slutar visas. null betyder tills det arkiveras för hand.
  endsAt DateTime? @map("ends_at")

  /// Var det syns. Ett underhåll som bara rör rapporterna behöver inte stå på
  /// väggen i verkstaden, och tvärtom.
  ///
  /// Säljsidan är den enda ytan som når någon som inte är kund. Ett pågående
  /// avbrott där är en trovärdighetsfråga: den som utvärderar tjänsten och
  /// märker att den inte svarar ska se att vi vet om det.
  showInAdmin Boolean @default(true) @map("show_in_admin")
  showOnKiosk Boolean @default(false) @map("show_on_kiosk")
  showOnSite  Boolean @default(false) @map("show_on_site")

  /// Satt när meddelandet tagits bort ur cirkulation. Raderas aldrig, så att
  /// det går att se i efterhand vad kunderna faktiskt fick se.
  archivedAt DateTime? @map("archived_at")

  createdByEmail String   @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([archivedAt, startsAt])
  @@map("system_notices")
}

model PlatformAuditLog {
  id              String   @id @default(cuid())
  actorEmail      String   @map("actor_email")
  action          String
  targetCompanyId String?  @map("target_company_id")
  detail          String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([targetCompanyId, createdAt])
  @@index([createdAt])
  @@map("platform_audit_log")
}

/// Intern anteckning om ett kundföretag. Syns bara i plattformspanelen.
///
/// Ligger i en egen tabell och inte på companies, så att den aldrig kan råka
/// följa med i en fråga som kunden själv gör.
model PlatformNote {
  targetCompanyId String   @id @map("target_company_id")
  body            String
  updatedByEmail  String   @map("updated_by_email")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("platform_notes")
}

/// En inbjudan att bli administratör.
///
/// Den inbjudne sätter sitt eget lösenord via en engångslänk. Alternativet —
/// att någon hittar på ett lösenord åt en annan person och skickar det — gör
/// att lösenordet passerar genom chatt eller mejl och blir känt av två personer
/// från start.
model AdminInvite {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  email     String
  role      AdminRole @default(ADMIN)

  /// Bara fingeravtrycket sparas, precis som för kioskskärmarnas tokens.
  tokenHash String @unique @map("token_hash")

  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  invitedByEmail String    @map("invited_by_email")
  createdAt      DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // En väntande inbjudan per adress och företag. Bjuder man in samma person
  // igen ska den gamla länken ersättas, inte ligga kvar parallellt.
  @@unique([companyId, email])
  @@index([companyId, acceptedAt])
  @@map("admin_invites")
}

/// En fysisk stämplingsskärm.
///
/// Skärmen loggar aldrig in. Den identifieras av en token i en cookie, och den
/// token kommer dit genom att någon matar in en sexsiffrig kod EN gång vid
/// uppsättningen.
///
/// Skärmen har tre lägen, som räknas fram i stället för att lagras:
///
///   Kopplad             — tokenHash finns
///   Väntar på koppling  — kod finns och har inte gått ut
///   Koden har gått ut   — varken token eller giltig kod
///
/// Det fanns tidigare ett fjärde läge, "återkallad". Det är borttaget: en
/// skärm som ska bort raderas, och en som ska kopplas om får en ny kod med
/// historiken kvar. Två lägen räckte där tre fanns.
model KioskDevice {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  name      String

  /// Fingeravtryck av skärmens token. Null betyder att skärmen väntar på att
  /// kopplas. Själva token finns bara i skärmens cookie och kan inte tas fram
  /// ur databasen — går den förlorad kopplas skärmen om.
  tokenHash String? @unique @map("token_hash")

  /// Fingeravtryck av den sexsiffriga engångskoden, och när den slutar gälla.
  ///
  /// Att fingeravtrycket sparas i stället för koden hjälper föga — sex siffror
  /// går att pröva sig igenom på ett ögonblick. Det som gör kortkoden
  /// försvarbar är att den lever fem minuter, förbrukas vid användning och att
  /// antalet gissningar är begränsat. Se redeemPairingCode i kiosk-auth.ts.
  pairingCodeHash  String?   @unique @map("pairing_code_hash")
  pairingExpiresAt DateTime? @map("pairing_expires_at")

  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([companyId])
  @@map("kiosk_devices")
}

/**
 * ==========================================================================
 * LÖNEUNDERLAG
 * ==========================================================================
 * Allt nedanför den här raden hör till tidrapporten, inte till
 * fakturaunderlaget. Gränsen är hård och vaktas av
 * tests/payroll-boundary.test.ts: ingen av lönemodulerna får importeras av
 * order-export.ts, pdf.ts, order-calc.ts eller report.ts.
 * Tikkr räknar TID. Vad tiden är värd i lön avgörs av kollektivavtalet, i
 * lönesystemet. Här finns därför inga lönearter, inga OB-tillägg och ingen
 * övertidsersättning. Se CLAUDE.md § 1.
 */

/// Ett arbetstidsschema. Ger PLANERAD tid, som flexsaldot mäts mot.
///
/// Ett företag har normalt ett enda schema som alla går på — därför
/// `isDefault`. Den som avviker får ett eget, kopplat via
/// `Employee.scheduleId`.
model WorkSchedule {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  name      String

  /// Schemat som gäller för den som inte har ett eget. Högst ett per företag.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  days      ScheduleDay[]
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId, isDefault])
  @@map("work_schedules")
}

/// En veckodag i ett schema. Saknas raden är dagen arbetsfri.
///
/// Tiderna lagras som MINUTER FRÅN MIDNATT och inte som klockslag i text.
/// Ett schema ska gå att räkna på, och "06:30" är inte ett tal. Minuter av
/// samma skäl som all annan tid i systemet lagras i minuter: 6,5 timmar går
/// inte att spara exakt som decimaltal.
model ScheduleDay {
  id         String @id @default(cuid())
  companyId  String @map("company_id")
  scheduleId String @map("schedule_id")

  /// 1 = måndag … 7 = söndag. ISO-8601, samma som veckovyn räknar med.
  weekday Int

  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  schedule WorkSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  breaks   ScheduleBreak[]

  @@unique([scheduleId, weekday])
  @@index([companyId, scheduleId])
  @@map("schedule_days")
}

/// En schemalagd rast. DRAS AV från den planerade tiden.
///
/// Schemats raster och de stämplade rasterna svarar på olika frågor. Den här
/// säger hur lång dagen är PLANERAD att vara: mån–tors 06:30–16:00 minus 20
/// minuters frukost och 40 minuters lunch är 8,5 timmar. Vad personen sedan
/// faktiskt tog står i break_entries, och skillnaden syns i flexsaldot.
model ScheduleBreak {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  scheduleDayId String @map("schedule_day_id")

  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  /// Vilken rast det är tänkt att vara. Frivillig — avdraget görs ändå.
  breakTypeId String? @map("break_type_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scheduleDay ScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  breakType   BreakType?  @relation(fields: [breakTypeId], references: [id], onDelete: SetNull)

  @@index([companyId, scheduleDayId])
  @@map("schedule_breaks")
}

/// En sorts rast: Frukost, Lunch, Fika.
///
/// EGET REGISTER, skilt från både arbetsmoment och improduktiva moment — och
/// det är med flit. Improduktiv tid är ARBETE som inte faktureras; en lunch är
/// inte arbete alls. Låg rasterna bland de improduktiva momenten skulle en
/// lunch räknas som närvarotid, och tidrapporten skulle visa 40 timmar där
/// personen arbetat 36.
model BreakType {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  name      String
  active    Boolean @default(true)

  /// Ordningen på stämplingsskärmen. Lägst först.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  breakEntries   BreakEntry[]
  scheduleBreaks ScheduleBreak[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("break_types")
}

/// En stämplad rast.
///
/// Ett rasttryck stänger ALLA pågående jobb. Därmed blir närvarotiden summan
/// av arbetspassen och rasten faller bort av sig själv — ingen befintlig
/// beräkning behöver veta att rasten finns. Posten här är kvittot på att
/// rasten togs, och underlaget för att se att den höll sin längd.
///
/// Ingen order, inget arbetsmoment, ingen timkostnad. Rasttid kan därför inte
/// nå ett fakturaunderlag ens av misstag.
model BreakEntry {
  id          String @id @default(cuid())
  companyId   String @map("company_id")
  employeeId  String @map("employee_id")
  breakTypeId String @map("break_type_id")

  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  source TimeEntrySource @default(KIOSK)

  /// Sattes av den automatiska stängningen, eller rättades för hand.
  needsReview Boolean @default(false) @map("needs_review")
  reviewNote  String? @map("review_note")

  /// Samma dubbelskydd som stämplingarna: offline-kön skickar om ett tryck
  /// den inte fått svar på, och utan nyckeln blir det två raster.
  clientPunchId String? @map("client_punch_id")

  kioskDeviceId String?  @map("kiosk_device_id")
  sourceIp      String?  @map("source_ip")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  breakType BreakType @relation(fields: [breakTypeId], references: [id], onDelete: Restrict)

  @@unique([companyId, clientPunchId])
  @@index([companyId, employeeId, endedAt])
  @@index([companyId, startedAt])
  @@map("break_entries")
}

/// En frånvarodag. Registreras av administratören, aldrig av kiosken.
///
/// Frånvaron TÄCKER den planerade tiden, vilket är hela poängen: en sjukdag
/// ska ge noll i flex, inte minus 8,5 timmar. Se flexformeln i payroll.ts.
model Absence {
  id         String @id @default(cuid())
  companyId  String @map("company_id")
  employeeId String @map("employee_id")

  /// Dagen frånvaron gäller, vid dygnets början i företagets tidszon.
  date DateTime

  type AbsenceType

  /// Antal minuter, för halvdagar. Tomt betyder hela den schemalagda dagen —
  /// vilket är något annat än noll, och det vanliga fallet.
  minutes Int?

  note String?

  /// Vem som registrerade den. Frånvaro är en känslig uppgift om en person,
  /// och den ska gå att spåra till en administratör.
  createdByEmail String @map("created_by_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // En person kan inte vara sjuk och sjuk samma dag. Två OLIKA sorter samma
  // dag är däremot rimligt: halva dagen semester, halva dagen VAB.
  @@unique([employeeId, date, type])
  @@index([companyId, employeeId, date])
  @@index([companyId, date])
  @@map("absences")
}

/// En post i komptidsboken. Plus är intjänat, minus är uttaget.
///
/// Intjänad komp skrivs in av administratören när övertid godkänts — den
/// uppstår aldrig av sig själv. Skälet: tid utöver schemat är flex till dess
/// att någon BESLUTAT att den är övertid, och det beslutet fattas av en
/// människa, inte av en stämplingsklocka.
///
/// Uttaget skrivs automatiskt när en frånvaro av typen KOMP_UTTAG registreras.
model CompAdjustment {
  id         String @id @default(cuid())
  companyId  String @map("company_id")
  employeeId String @map("employee_id")

  date DateTime

  /// Positivt = intjänat, negativt = uttaget. Aldrig noll.
  minutes Int

  note String?

  createdByEmail String @map("created_by_email")

  /// Frånvaroposten uttaget hör till, när det kommer därifrån. Låter
  /// borttagen frånvaro städa bort sin egen komprad.
  absenceId String? @unique @map("absence_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, date])
  @@map("comp_adjustments")
}
